# 这个文件不会被程序自动读取。
# 它只是给开发者看的环境变量清单，用来说明运行项目时需要准备哪些配置。
# 真正被 Spring Boot 读取的是 src/main/resources/application.properties。

# Server
SERVER_PORT=8080

# Startup validation
STARTUP_VALIDATION_ENABLED=true
STARTUP_VALIDATION_FAIL_FAST=false

# Chat memory policy
CHAT_MEMORY_MAX_WINDOW_MESSAGES=20
CHAT_MEMORY_MIN_WINDOW_MESSAGES=4

# Private medical file upload
MEDICAL_FILE_STORAGE_DIR=data/uploads/medical
MEDICAL_UPLOAD_MAX_FILE_SIZE=10MB
MEDICAL_UPLOAD_MAX_REQUEST_SIZE=11MB
MEDICAL_UPLOAD_MAX_BYTES=10485760
MEDICAL_EXTRACTION_MAX_CHARACTERS=100000
MEDICAL_EXTRACTION_MAX_PDF_PAGES=100
MEDICAL_OCR_PROVIDER=paddle
MEDICAL_OCR_BASE_URL=http://127.0.0.1:18080
MEDICAL_OCR_ENDPOINT=https://replace_with_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
MEDICAL_OCR_API_KEY=replace_me
MEDICAL_OCR_MODEL=qwen3.5-ocr
MEDICAL_OCR_CONNECT_TIMEOUT_SECONDS=5
MEDICAL_OCR_READ_TIMEOUT_SECONDS=60

# Online LLM provider
# QWEN_CHAT_MODEL and QWEN_STREAMING_MODEL are called through the native DashScope SDK
# (langchain4j-community-dashscope). Use public native models such as qwen-plus or qwen-max.
# Models only available on the dedicated MaaS workspace endpoint (for example qwen3.8-flash,
# served at .../compatible-mode/v1) need the OpenAI-compatible client and will return
# HTTP 404 response_error if configured here. Never set
# langchain4j.community.dashscope.chat-model.base-url to a /compatible-mode/v1 address.
QWEN_API_KEY=replace_me
QWEN_CHAT_MODEL=qwen-max
QWEN_STREAMING_MODEL=qwen-max
QWEN_EMBEDDING_MODEL=text-embedding-v3
RAG_ANSWER_GENERATOR_MODE=online
RAG_EMBEDDING_PROVIDER=dashscope
RAG_RERANK_PROVIDER=dashscope
QWEN_RERANK_MODEL=qwen3-rerank
QWEN_WORKSPACE_ID=replace_me

# Databases
MYSQL_URL=jdbc:mysql://localhost:3306/guiguxiaozhi?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace_me
MONGODB_URI=mongodb://localhost:27017/chat_memory_db

# Search and Elasticsearch knowledge store
TAVILY_API_KEY=replace_me
ALIYUN_ELASTICSEARCH_ENDPOINT=https://replace_me.public.elasticsearch.aliyuncs.com:9200
ALIYUN_ELASTICSEARCH_USERNAME=elastic
ALIYUN_ELASTICSEARCH_PASSWORD=replace_me
ALIYUN_ELASTICSEARCH_INDEX=xiaozhi-medical-knowledge
ALIYUN_ELASTICSEARCH_TEXT_ANALYZER=standard
ALIYUN_ELASTICSEARCH_SEARCH_ANALYZER=standard
ALIYUN_ELASTICSEARCH_KEYWORD_WEIGHT=1.0
ALIYUN_ELASTICSEARCH_VECTOR_WEIGHT=1.0
ALIYUN_ELASTICSEARCH_REBUILD_ON_STARTUP=false
ALIYUN_ELASTICSEARCH_MARKER_DIR=data/rag/elasticsearch
ALIYUN_ELASTICSEARCH_BATCH_SIZE=10

# Knowledge sources
RAG_PUMCH_DEPARTMENT_PAGES_ENABLED=true
RAG_PUMCH_DEPARTMENT_PAGES_SOURCE_DIR=docs/knowledge/raw/pumch/2026-07-31/department-pages
